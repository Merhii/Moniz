<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moniz_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/moniz_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/moniz_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.08"
        android:text="MONIZ"
        android:textAllCaps="true"
        android:textColor="#F7D38D"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moniz_widget_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/moniz_widget_accent_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp"
        android:text="+ Add entry"
        android:textColor="#0A2447"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moniz_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap the tile to open MONIZ"
        android:textColor="#D8D0C5"
        android:textSize="12sp" />
</LinearLayout>
